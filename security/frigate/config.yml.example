# =============================================================================
# Frigate Configuration
# =============================================================================
# Documentation: https://docs.frigate.video/
#
# Copy this file to config.yml and customize for your setup

# MQTT broker for events (connects to local MQTT container)
mqtt:
  enabled: true
  host: mqtt
  port: 1883
  topic_prefix: frigate
  client_id: frigate
  # user: your_mqtt_user
  # password: your_mqtt_password

# Database for events
database:
  path: /media/frigate/frigate.db

# Detection configuration
detectors:
  # CPU detection (no hardware acceleration)
  cpu1:
    type: cpu
    num_threads: 4

  # Uncomment for Google Coral USB
  # coral:
  #   type: edgetpu
  #   device: usb

# Model configuration
model:
  width: 320
  height: 320
  input_tensor: nhwc
  input_pixel_format: rgb
  labelmap_path: /labelmap.txt

# Object tracking
objects:
  track:
    - person
    - car
    - dog
    - cat
  filters:
    person:
      min_area: 2000
      max_area: 100000
      min_score: 0.5
      threshold: 0.7

# Recording configuration
record:
  enabled: true
  retain:
    days: 0  # Don't keep continuous recording
    mode: motion
  events:
    pre_capture: 5
    post_capture: 5
    retain:
      default: 7
      mode: motion

# Snapshot configuration (for DoubleTake)
snapshots:
  enabled: true
  timestamp: true
  bounding_box: true
  crop: false
  retain:
    default: 7

# RTSP restream
rtsp:
  enabled: true

# Web UI
ui:
  live_mode: mse

# =============================================================================
# CAMERAS
# =============================================================================
# Add your cameras below. Example configurations provided.

cameras:
  # ---------------------------------------------------------------------------
  # Example: Indoor camera (entrance)
  # ---------------------------------------------------------------------------
  ingresso:
    enabled: true
    ffmpeg:
      inputs:
        # Main stream for recording
        - path: rtsp://admin:password@192.168.1.100:554/Streaming/Channels/101
          roles:
            - record
        # Sub stream for detection (lower resolution = faster)
        - path: rtsp://admin:password@192.168.1.100:554/Streaming/Channels/102
          roles:
            - detect
    detect:
      enabled: true
      width: 1280
      height: 720
      fps: 5
    motion:
      threshold: 25
      contour_area: 100
    objects:
      track:
        - person
      filters:
        person:
          min_area: 3000
          min_score: 0.6
    snapshots:
      enabled: true
    record:
      enabled: true
      events:
        retain:
          default: 14

  # ---------------------------------------------------------------------------
  # Example: Outdoor camera (courtyard)
  # ---------------------------------------------------------------------------
  # cortile:
  #   enabled: true
  #   ffmpeg:
  #     inputs:
  #       - path: rtsp://admin:password@192.168.1.101:554/stream
  #         roles:
  #           - detect
  #           - record
  #   detect:
  #     enabled: true
  #     width: 1920
  #     height: 1080
  #     fps: 5
  #   motion:
  #     threshold: 30
  #   objects:
  #     track:
  #       - person
  #       - car
  #   zones:
  #     driveway:
  #       coordinates: 0.0,0.5,0.4,0.5,0.4,1.0,0.0,1.0
  #       objects:
  #         - car
  #     entrance:
  #       coordinates: 0.4,0.3,0.7,0.3,0.7,0.8,0.4,0.8
  #       objects:
  #         - person

# =============================================================================
# VERSION
# =============================================================================
version: 0.13
