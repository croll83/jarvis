+            # Fix broken Linear4bit modules: config.json skip list patterns
+            # (e.g. "shared_mlp") don't match nested paths like
+            # "layers.0.mlp.shared_mlp.gate_and_up_proj", so transformers
+            # incorrectly converts them to Linear4bit. These modules have
+            # bf16 weights stored as uint8 without quant_state → broken.
+            # Fix: convert them back to nn.Linear with proper bf16 weights.
+            import bitsandbytes as bnb
+            from safetensors import safe_open
+            
+            fixed_count = 0
+            index_path = os.path.join(model_path, "model.safetensors.index.json")
+            if os.path.exists(index_path):
+                with open(index_path) as f:
+                    weight_map = json.load(f)["weight_map"]
+                
+                shard_cache = {}
+                for name, module in model.named_modules():
+                    if isinstance(module, bnb.nn.Linear4bit):
+                        w = module.weight
+                        if isinstance(w, bnb.nn.Params4bit) and hasattr(w, "quant_state") and w.quant_state is not None:
+                            continue
+                        # This Linear4bit has no quant_state - reload as bf16
+                        weight_key = f"{name}.weight"
+                        shard = weight_map.get(weight_key)
+                        if shard is None:
+                            continue
+                        shard_path = os.path.join(model_path, shard)
+                        if shard_path not in shard_cache:
+                            shard_cache[shard_path] = safe_open(shard_path, framework="pt")
+                        sf = shard_cache[shard_path]
+                        if weight_key not in sf.keys():
+                            continue
+                        orig_tensor = sf.get_tensor(weight_key)
+                        if orig_tensor.dtype != torch.bfloat16:
+                            continue
+                        # Replace with nn.Linear
+                        new_linear = torch.nn.Linear(
+                            orig_tensor.shape[1], orig_tensor.shape[0],
+                            bias=module.bias is not None,
+                            dtype=torch.bfloat16,
+                            device=w.device,
+                        )
+                        new_linear.weight.data.copy_(orig_tensor.to(w.device))
+                        if module.bias is not None:
+                            bias_key = f"{name}.bias"
+                            if bias_key in sf.keys():
+                                new_linear.bias.data.copy_(sf.get_tensor(bias_key).to(w.device))
+                        # Replace in parent
+                        parts = name.rsplit(".", 1)
+                        if len(parts) == 2:
+                            parent = model.get_submodule(parts[0])
+                            setattr(parent, parts[1], new_linear)
+                        else:
+                            setattr(model, name, new_linear)
+                        fixed_count += 1
+                
+                if fixed_count > 0:
+                    logger.info(f"Fixed {fixed_count} Linear4bit modules with missing quant_state (restored to bf16 nn.Linear)")
+            
