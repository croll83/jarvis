---
# =============================================================================
# JARVIS — Ansible Inventory
# =============================================================================
# Copia questo file in hosts.yml e aggiorna gli IP con l'output di Terraform:
#   cp hosts.yml.example hosts.yml
#   nano hosts.yml
#
# L'IP lo trovi con:
#   cd ../terraform && terraform output ipv4_address
#
# Scenario locale: 2 VM separate (jarvis + openclaw)
# Scenario cloud:  1 VPS (tutto su stesso host, usa setup-vps.sh)

all:
  hosts:
    jarvis:
      ansible_host: 192.168.1.50     # <-- IP VM JARVIS (orchestrator + docker stack)
      ansible_user: jarvis
      ansible_become: true

# Gruppo per il LXC OpenClaw (deploy locale)
# OpenClaw gira su LXC separato con Node.js, Chrome headless, Linuxbrew
openclaw:
  hosts:
    jarvis-openclaw:
      ansible_host: 192.168.1.51     # <-- IP LXC-OpenClaw (bare-metal)
      ansible_user: jarvis
      ansible_become: true

# Gruppo per i LXC Wakeword (opzionale — uno per casa/LAN)
wakeword:
  hosts:
    jarvis-wakeword:
      ansible_host: 192.168.1.45     # <-- IP LXC-Wakeword
      ansible_user: root
      ansible_become: false

# Gruppo per la VM Workstation (opzionale)
# Ubuntu Desktop + Chrome reale + OpenClaw browser extension + IDE
workstation:
  hosts:
    jarvis-workstation:
      ansible_host: 192.168.1.60     # <-- IP VM Workstation
      ansible_user: jarvis
      ansible_become: true

# Gruppo per il GB10 DGX Spark (heavy LLM remoto, sede separata via Tailscale)
# Ospita: parakeet-stt, cosyvoice3-tts, dark-jarvis (llama.cpp stock + MTP), comfyui, ace-step
# Setup gestito dal playbook gb10.yml (build llama-cpp-stock + dark-jarvis.service)
gb10:
  hosts:
    gx10-3b82:
      ansible_host: 100.98.187.12    # <-- Tailscale IP (sede remota)
      ansible_user: jarvis
      ansible_become: true
