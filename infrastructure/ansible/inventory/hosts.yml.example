---
# =============================================================================
# JARVIS — Ansible Inventory
# =============================================================================
# Copia questo file in hosts.yml e aggiorna l'IP con l'output di Terraform:
#   cp hosts.yml.example hosts.yml
#   nano hosts.yml
#
# L'IP lo trovi con:
#   cd ../terraform && terraform output ipv4_address

all:
  hosts:
    jarvis:
      ansible_host: 192.168.1.50     # <-- Sostituisci con IP da terraform output
      ansible_user: jarvis            # Per VM con cloud-init
      # ansible_user: root            # Per LXC (decommentare)
      ansible_become: true
