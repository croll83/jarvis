# =============================================================================
# JARVIS Environment Configuration
# Generato da Ansible — NON modificare manualmente
# Per aggiornare: modifica group_vars/all.yml e riesegui Ansible
# =============================================================================

# =============================================================================
# AI BACKEND CONFIGURATION
# =============================================================================
AI_BACKEND={{ ai_backend }}

# --- Groq API (STT - Whisper cloud) ---
GROQ_API_KEY={{ groq_api_key | default('', true) }}

# --- OpenRouter API (Routing fallback) ---
OPENROUTER_API_KEY={{ openrouter_api_key | default('', true) }}

# --- Google Gemini API (AI Agent cloud LLM) ---
GEMINI_API_KEY={{ gemini_api_key | default('', true) }}

# --- Brave Search API (web_search tool) ---
BRAVE_API_KEY={{ brave_api_key | default('', true) }}

# --- Router locale (Qwen) ---
# Produzione: llama-server con Qwen3.5-4B-Q6_K.gguf, alias "model", porta 30000
# (systemd llama-router.service). Ollama resta supportato per dev.
# Il 4B ha sostituito il 7B: misurato meglio sullo stesso banco di 426 casi
# (payload 71,4% contro 68,3%) e libera 2,2 GB di VRAM.
ROUTER_ENGINE={{ router_engine | default('llamacpp', true) }}
ROUTER_URL={{ router_url | default('http://localhost:30000', true) }}
ROUTER_MODEL={{ router_model | default('model', true) }}

# =============================================================================
# CATENA DI ROUTING
# =============================================================================
# Tre decisori, in ordine: GLiNER (locale, ~70ms) → Jev (cloud, ~470ms) →
# Qwen (locale generativo, ~1200ms). Qwen non si disattiva: e' il solo che sa
# generare testo libero, quindi chiude la catena per definizione.
#
# LA REGOLA: un motore entra in catena se e' CONFIGURATO.
#   gliner_url valorizzato + jev_api_key  →  GLiNER → Jev → Qwen
#   solo gliner_url                       →  GLiNER → Qwen
#   solo jev_api_key                      →  Jev → Qwen
#   nessuno dei due                       →  Qwen
#
# gliner_enabled / jev_enabled sono interruttori ESPLICITI per spegnere un
# motore senza cancellarne la configurazione: se non li si dichiara vale la
# presenza della configurazione, se li si dichiara hanno l'ultima parola — ma
# non possono accendere un motore non configurato.
#
# L'ordine effettivo viene loggato all'avvio: cerca "Catena di routing".

# --- GLiNER — decisore primario, locale -----------------------------------
# Gira FUORI dal container, come systemd sull'host (gliner-router.service,
# porta 11436): il container ha torch CPU e su CPU il bersaglio costa 1370ms
# contro 34ms in GPU. Vuole ~1,65 GiB di VRAM, che sulla 5070 da 8GB stanno
# insieme al router generativo (4,7 GiB).
# Misurato sul banco dei 426 casi: intento 90,8%, bersaglio 84,0%, azione
# 88,6%, payload 74,5%, p50 68ms. Contro Jev: 89,2 / 73,2 / 86,8 / 66,4 / 470ms.
GLINER_URL={{ gliner_url | default('', true) }}
GLINER_TIMEOUT={{ gliner_timeout | default(3, true) }}
GLINER_MIN_CONFIDENCE={{ gliner_min_confidence | default(0.45, true) }}
{% if gliner_enabled is defined %}GLINER_ENABLED={{ gliner_enabled | lower }}
{% endif %}
# --- Jev (TypeSafe System One) — decisore opzionale, cloud a consumo ------
# Una chiamata con 12 domande tipizzate in parallelo. Sta FRA GLiNER e Qwen:
# lascia jev_api_key vuota per non usarlo.
JEV_API_KEY={{ jev_api_key | default('', true) }}
JEV_URL={{ jev_url | default('https://api.typesafe.ai/v1/systemone', true) }}
JEV_MODEL={{ jev_model | default('jev-latest', true) }}
JEV_TIMEOUT={{ jev_timeout | default(4, true) }}
JEV_MIN_CONFIDENCE={{ jev_min_confidence | default(0.70, true) }}
JEV_MIN_ENTITY_CONFIDENCE={{ jev_min_entity_confidence | default(0.60, true) }}
JEV_FREETEXT_THRESHOLD={{ jev_freetext_threshold | default(0.50, true) }}
JEV_INJECTION_THRESHOLD={{ jev_injection_threshold | default(0.60, true) }}
{% if jev_enabled is defined %}JEV_ENABLED={{ jev_enabled | lower }}
{% endif %}
# Prompt di Qwen generato da router_model invece che dal file statico.
# SPENTO: misurato 61,3% di payload contro 68,3% del prompt scritto a mano,
# pur pareggiando l'intent con meta' dei token. Vedi render_flat.py.
ROUTER_PROMPT_GENERATO={{ router_prompt_generato | default(false, true) | lower }}

# =============================================================================
# AI AGENT CONFIGURATION (Hermes/OpenClaw/others — bare-metal, su VM separata o stesso host)
# =============================================================================
AI_AGENT_URL={{ ai_agent_url | default('', true) }}
AI_AGENT_TOKEN={{ ai_agent_token | default('', true) }}
AI_AGENT_TELEGRAM_BOT_TOKEN={{ ai_agent_telegram_bot_token | default('', true) }}
AI_AGENT_WS_URL={{ ai_agent_ws_url | default('', true) }}

# =============================================================================
# JARVIS APPROVAL BOT (L3 critical actions)
# =============================================================================
JARVIS_APPROVAL_BOT_TOKEN={{ jarvis_approval_bot_token | default('', true) }}
JARVIS_APPROVAL_CHAT_ID={{ jarvis_approval_chat_id | default('', true) }}

# =============================================================================
# HOME ASSISTANT CONFIGURATION
# =============================================================================
HASS_URL={{ hass_url }}
JARVIS_HASS_TOKEN={{ hass_token }}

# =============================================================================
# EMAIL CONFIGURATION (OTP Authentication)
# =============================================================================
JARVIS_SMTP_HOST={{ smtp_host | default('smtp.gmail.com', true) }}
JARVIS_SMTP_PORT={{ smtp_port | default(587, true) }}
JARVIS_SMTP_USER={{ smtp_user | default('', true) }}
JARVIS_SMTP_PASSWORD={{ smtp_password | default('', true) }}
JARVIS_SMTP_FROM={{ smtp_from | default('jarvis@yourdomain.com', true) }}
JARVIS_SMTP_TLS={{ smtp_tls | default(true, true) | string | lower }}

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL={{ log_level | default('INFO', true) }}

# =============================================================================
# API TIMEOUTS (secondi)
# =============================================================================
API_TIMEOUT_STT={{ api_timeout_stt | default(30, true) }}
API_TIMEOUT_ROUTING={{ api_timeout_routing | default(30, true) }}

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER={{ postgres_user | default('jarvis', true) }}
POSTGRES_PASSWORD={{ postgres_password | default('', true) }}
POSTGRES_DB={{ postgres_db | default('main', true) }}
MONGO_USER={{ mongo_user | default('jarvis', true) }}
MONGO_PASSWORD={{ mongo_password | default('', true) }}

# =============================================================================
# ONTOLOGY SERVER
# =============================================================================
ONTOLOGY_API_TOKEN={{ ontology_api_token | default('', true) }}

# =============================================================================
# DEVICE FIRMWARE AUTH
# =============================================================================
DEVICE_API_TOKEN={{ device_api_token | default('', true) }}

# =============================================================================
# TELEGRAM WEBHOOK (opzionale)
# =============================================================================
TELEGRAM_WEBHOOK_URL={{ telegram_webhook_url | default('', true) }}

# =============================================================================
# TTS ENGINE
# =============================================================================
# "cosyvoice3" (CosyVoice3-0.5B su GX10, GPU) o "kokoro" (Kokoro-82M, CPU fallback)
# Deploy locale: CosyVoice3 su GX10 via Tailscale
# Deploy cloud: Kokoro (CPU)
TTS_ENGINE={{ tts_engine | default('cosyvoice3' if (deploy_type == 'lxc_gpu' and ai_backend == 'local') else 'kokoro', true) }}
{% if (tts_engine | default('')) in ('cosyvoice3', 'qwen3tts') or (deploy_type == 'lxc_gpu' and ai_backend == 'local') %}
COSYVOICE3_TTS_URL={{ cosyvoice3_tts_url | default('http://100.98.187.12:9880', true) }}
COSYVOICE3_TTS_VOICE={{ cosyvoice3_tts_voice | default('sofia', true) }}
COSYVOICE3_TTS_LANGUAGE={{ cosyvoice3_tts_language | default('it', true) }}
{% elif tts_engine | default('') == 'kokoro' or (deploy_type != 'lxc_gpu') %}
KOKORO_TTS_URL=http://localhost:8890
{% endif %}

# =============================================================================
# WAKEWORD SERVERS (opzionale)
# =============================================================================
WAKEWORD_SERVER_URLS={{ wakeword_server_urls | default('', true) }}

# =============================================================================
# REDIS (cross-system context bus)
# =============================================================================
REDIS_URL={{ redis_url | default('redis://localhost:6379/0', true) }}

# =============================================================================
# MEM0 (long-term behavioral memory)
# =============================================================================
MEM0_BASE_URL={{ mem0_base_url | default('http://localhost:8200', true) }}
{% if install_security_stack | default(false) %}

# =============================================================================
# SECURITY STACK
# =============================================================================
FRIGATE_URL=http://localhost:5001
MQTT_HOST=localhost
MQTT_PORT=1883
{% endif %}
