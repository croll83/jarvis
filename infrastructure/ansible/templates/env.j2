# =============================================================================
# JARVIS Environment Configuration
# Generato da Ansible — NON modificare manualmente
# Per aggiornare: modifica group_vars/all.yml e riesegui Ansible
# =============================================================================

# =============================================================================
# AI BACKEND CONFIGURATION
# =============================================================================
AI_BACKEND={{ ai_backend }}

# --- Groq API (STT - Whisper cloud) ---
GROQ_API_KEY={{ groq_api_key | default('', true) }}

# --- OpenRouter API (Routing fallback) ---
OPENROUTER_API_KEY={{ openrouter_api_key | default('', true) }}

# --- Google Gemini API (AI Agent cloud LLM) ---
GEMINI_API_KEY={{ gemini_api_key | default('', true) }}

# --- Brave Search API (web_search tool) ---
BRAVE_API_KEY={{ brave_api_key | default('', true) }}

# --- Router Model ---
ROUTER_MODEL={{ router_model | default('qwen2.5:3b', true) }}

# =============================================================================
# AI AGENT CONFIGURATION (Hermes/OpenClaw/others — bare-metal, su VM separata o stesso host)
# =============================================================================
AI_AGENT_URL={{ ai_agent_url | default('', true) }}
AI_AGENT_TOKEN={{ ai_agent_token | default('', true) }}
AI_AGENT_TELEGRAM_BOT_TOKEN={{ ai_agent_telegram_bot_token | default('', true) }}
AI_AGENT_WS_URL={{ ai_agent_ws_url | default('', true) }}

# =============================================================================
# JARVIS APPROVAL BOT (L3 critical actions)
# =============================================================================
JARVIS_APPROVAL_BOT_TOKEN={{ jarvis_approval_bot_token | default('', true) }}
JARVIS_APPROVAL_CHAT_ID={{ jarvis_approval_chat_id | default('', true) }}

# =============================================================================
# HOME ASSISTANT CONFIGURATION
# =============================================================================
HASS_URL={{ hass_url }}
JARVIS_HASS_TOKEN={{ hass_token }}

# =============================================================================
# EMAIL CONFIGURATION (OTP Authentication)
# =============================================================================
JARVIS_SMTP_HOST={{ smtp_host | default('smtp.gmail.com', true) }}
JARVIS_SMTP_PORT={{ smtp_port | default(587, true) }}
JARVIS_SMTP_USER={{ smtp_user | default('', true) }}
JARVIS_SMTP_PASSWORD={{ smtp_password | default('', true) }}
JARVIS_SMTP_FROM={{ smtp_from | default('jarvis@yourdomain.com', true) }}
JARVIS_SMTP_TLS={{ smtp_tls | default(true, true) | string | lower }}

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL={{ log_level | default('INFO', true) }}

# =============================================================================
# API TIMEOUTS (secondi)
# =============================================================================
API_TIMEOUT_STT={{ api_timeout_stt | default(30, true) }}
API_TIMEOUT_ROUTING={{ api_timeout_routing | default(30, true) }}

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER={{ postgres_user | default('jarvis', true) }}
POSTGRES_PASSWORD={{ postgres_password | default('', true) }}
POSTGRES_DB={{ postgres_db | default('main', true) }}
MONGO_USER={{ mongo_user | default('jarvis', true) }}
MONGO_PASSWORD={{ mongo_password | default('', true) }}

# =============================================================================
# ONTOLOGY SERVER
# =============================================================================
ONTOLOGY_API_TOKEN={{ ontology_api_token | default('', true) }}

# =============================================================================
# DEVICE FIRMWARE AUTH
# =============================================================================
DEVICE_API_TOKEN={{ device_api_token | default('', true) }}

# =============================================================================
# TELEGRAM WEBHOOK (opzionale)
# =============================================================================
TELEGRAM_WEBHOOK_URL={{ telegram_webhook_url | default('', true) }}

# =============================================================================
# TTS ENGINE
# =============================================================================
# "xtts" (XTTSv2 Coqui, GPU) o "kokoro" (Kokoro-82M, CPU fallback)
# Deploy locale GPU: XTTS su localhost:8890
# Deploy cloud con LXC remoto: XTTS raggiungibile via Tailscale (xtts_url in group_vars)
TTS_ENGINE={{ tts_engine | default('xtts' if (deploy_type == 'lxc_gpu' and ai_backend == 'local') else 'kokoro', true) }}
{% if (tts_engine | default('')) == 'xtts' or (deploy_type == 'lxc_gpu' and ai_backend == 'local') %}
XTTS_URL={{ xtts_url | default('http://localhost:8890', true) }}
XTTS_SPEAKER={{ xtts_speaker | default('default', true) }}
XTTS_LANGUAGE={{ xtts_language | default('it', true) }}
{% elif tts_engine | default('') == 'kokoro' or (deploy_type != 'lxc_gpu') %}
KOKORO_TTS_URL=http://localhost:8890
{% endif %}

# =============================================================================
# WAKEWORD SERVERS (opzionale)
# =============================================================================
WAKEWORD_SERVER_URLS={{ wakeword_server_urls | default('', true) }}

# =============================================================================
# REDIS (cross-system context bus)
# =============================================================================
REDIS_URL={{ redis_url | default('redis://localhost:6379/0', true) }}

# =============================================================================
# MEM0 (long-term behavioral memory)
# =============================================================================
MEM0_BASE_URL={{ mem0_base_url | default('http://localhost:8200', true) }}
{% if install_security_stack | default(false) %}

# =============================================================================
# SECURITY STACK
# =============================================================================
FRIGATE_URL=http://localhost:5001
MQTT_HOST=localhost
MQTT_PORT=1883
{% endif %}
