---
# =============================================================================
# JARVIS — Variabili Ansible
# =============================================================================
# Copia questo file in all.yml e compila i valori:
#   cp all.yml.example all.yml
#   nano all.yml
#
# Per cifrare i segreti con Ansible Vault:
#   ansible-vault encrypt all.yml
#
# NON committare all.yml nel repository!

# =============================================================================
# DEPLOYMENT
# =============================================================================
# Deve corrispondere a deploy_type in Terraform
deploy_type: "lxc_gpu"         # "lxc_gpu" o "lxc"
ai_backend: "local"            # "local" (GPU + Ollama/Whisper) o "api" (cloud APIs)

# =============================================================================
# REPOSITORY
# =============================================================================
jarvis_repo: "https://github.com/croll83/jarvis.git"
jarvis_branch: "main"
jarvis_dir: "/opt/jarvis"
jarvis_user: "jarvis"

# =============================================================================
# DOCKER
# =============================================================================
docker_log_max_size: "10m"
docker_log_max_file: "3"

# =============================================================================
# NVIDIA (solo per deploy_type: lxc_gpu)
# =============================================================================
# Il driver è installato sull'HOST Proxmox, non nel container.
# GPU VRAM budget: Qwen 2.5 3B (~2.6GB) — STT/TTS su GX10, embeddings su CPU
ollama_gpu_layers: 15           # 6GB->10, 8GB->15, 12GB->25, 16GB+->40
ollama_num_ctx: 4096

# =============================================================================
# AI API KEYS
# =============================================================================
# Groq — STT via Whisper API — https://console.groq.com/keys
groq_api_key: ""

# OpenRouter — Routing fallback — https://openrouter.ai/keys
openrouter_api_key: ""

# Gemini — OpenClaw brain — https://aistudio.google.com/app/apikey
gemini_api_key: ""

# Brave Search — web_search tool — https://brave.com/search/api/
brave_api_key: ""

# Ontology Server — Knowledge Graph API auth
ontology_api_token: ""

# ─────────────────────────────────────────────── CATENA DI ROUTING ──
# Tre decisori, in ordine: GLiNER (locale, ~70ms) → Jev (cloud, ~470ms) →
# Qwen (locale generativo, ~1200ms). Qwen non si disattiva: e' il solo che sa
# generare testo libero.
#
# LA REGOLA: un motore entra in catena se e' CONFIGURATO.
#   gliner_url + jev_api_key  →  GLiNER → Jev → Qwen
#   solo gliner_url           →  GLiNER → Qwen
#   solo jev_api_key          →  Jev → Qwen
#   nessuno dei due           →  Qwen
#
# gliner_enabled / jev_enabled sono interruttori ESPLICITI, opzionali: servono
# a spegnere un motore senza cancellarne la configurazione. Dichiararli non
# puo' ACCENDERE un motore non configurato.

# Router locale (Qwen) — ultimo anello. Produzione: llama-server :30000 con
# Qwen3.5-4B-Q6_K.gguf servito con alias "model". Ha sostituito il 7B: misurato
# meglio sullo stesso banco (payload 71,4% contro 68,3%) e libera 2,2 GB.
router_engine: "llamacpp"          # llamacpp | ollama
router_url: "http://localhost:30000"
router_model: "model"

# GLiNER — decisore primario, locale. Gira come systemd sull'host
# (gliner-router.service), NON nel container: il container ha torch CPU e su
# CPU il bersaglio costa 1370ms contro 34ms in GPU. Vuole ~1,65 GiB di VRAM.
# Misurato sui 426 casi: intento 90,8%, bersaglio 84,0%, payload 74,5%, p50 68ms.
# Lascia vuoto per non usarlo.
gliner_url: "http://localhost:11436"
gliner_timeout: 3
gliner_min_confidence: 0.45        # sotto soglia E natura incerta -> passa la mano
# gliner_enabled: false            # spegnilo senza cancellare l'URL

# Prompt di Qwen generato da router_model invece che dal file statico.
# SPENTO: misurato 61,3% di payload contro 68,3% dello scritto a mano, pur
# pareggiando l'intent con meta' dei token. Vedi jarvis-orchestrator/render_flat.py.
router_prompt_generato: false

# Jev (TypeSafe System One) — decisore OPZIONALE, sta fra GLiNER e Qwen.
# Chiave su https://typesafe.ai — formato apikey_<32hex>_<64hex>.
# Lascia jev_api_key vuota per non usarlo. Misurato: payload 66,4% contro il
# 74,5% di GLiNER, a 470ms contro 68ms — ed e' cloud, quindi a consumo.
# jev_enabled: false               # spegnilo senza cancellare la chiave
jev_api_key: ""
jev_url: "https://api.typesafe.ai/v1/systemone"
jev_model: "jev-latest"
jev_timeout: 4
jev_min_confidence: 0.70           # sotto soglia -> fallback su Qwen
jev_min_entity_confidence: 0.60
jev_freetext_threshold: 0.50       # serve slot di testo libero -> Qwen
jev_injection_threshold: 0.60

# =============================================================================
# OPENCLAW (Brain - Gemini 3 Pro, bare-metal su VM separata)
# =============================================================================
# URL di OpenClaw — Tailscale MagicDNS o IP LAN della VM-OpenClaw
# Cloud (stesso host): http://localhost:18789
# Locale (VM separata): http://jarvis-openclaw:18789 (Tailscale) o http://192.168.x.x:18789
openclaw_url: "http://jarvis-openclaw:18789"

# Gateway token — genera con: openssl rand -hex 32
# DEVE essere lo stesso valore usato in "openclaw onboard" sulla VM-OpenClaw
openclaw_gateway_token: ""

# OpenClaw Telegram bot — Crea con @BotFather su Telegram
openclaw_telegram_bot_token: ""

# OpenClaw Gateway WS — operator mode per exec approval buttons
# Same IP/port as openclaw_url but con ws:// scheme
openclaw_ws_url: "ws://jarvis-openclaw:18789"

# OpenClaw Exec Approval Socket — token from ~/.openclaw/exec-approvals.json
# L'orchestrator ascolta su questo socket; OpenClaw si connette per chiedere approvazioni.
openclaw_approval_socket_path: "/home/jarvis/.openclaw/exec-approvals.sock"
openclaw_approval_socket_token: ""

# =============================================================================
# JARVIS APPROVAL BOT (L3 critical actions)
# =============================================================================
# Separate Telegram bot for security confirmations (locks, alarm, cameras)
# Prevents prompt injection via OpenClaw channel
jarvis_approval_bot_token: ""
jarvis_approval_chat_id: ""

# =============================================================================
# HOME ASSISTANT
# =============================================================================
# URL dell'istanza HA (Tailscale per remote, IP locale per same-network)
hass_url: "http://192.168.1.20:8123"

# Long-lived access token — Crea da: HA > Profilo > Token accesso
hass_token: "il_tuo_long_lived_access_token"

# =============================================================================
# EMAIL (OTP Authentication)
# =============================================================================
smtp_host: "smtp.gmail.com"
smtp_port: 587
smtp_user: ""
smtp_password: ""               # Per Gmail: usa "App Password"
smtp_from: "jarvis@yourdomain.com"
smtp_tls: true

# =============================================================================
# LOGGING
# =============================================================================
log_level: "INFO"               # DEBUG, INFO, WARNING, ERROR

# =============================================================================
# TIMEOUTS API (secondi)
# =============================================================================
api_timeout_stt: 30
api_timeout_routing: 30

# =============================================================================
# DATABASE (docker-compose.yml)
# =============================================================================
postgres_user: "jarvis"
postgres_password: ""           # Password PostgreSQL
postgres_db: "main"
mongo_user: "jarvis"
mongo_password: ""              # Password MongoDB

# =============================================================================
# DEVICE FIRMWARE AUTH (AtomS3R Bearer Token)
# =============================================================================
# Token statico per autenticazione device firmware (AtomS3R).
# Genera con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Deve corrispondere a CONFIG_JARVIS_API_TOKEN nell'sdkconfig AtomS3R.
# Se vuoto, autenticazione device disabilitata.
device_api_token: ""

# =============================================================================
# TELEGRAM WEBHOOK (opzionale)
# =============================================================================
# URL HTTPS pubblico per webhook Telegram bot.
# Se impostato, registra webhook all'avvio invece di usare getUpdates polling.
# Richiede reverse proxy (nginx) con certificato SSL valido.
# Esempio: https://jarvis-pub.yourdomain.com/telegram_webhook
telegram_webhook_url: ""

# =============================================================================
# WAKEWORD SERVERS (opzionale — uno per casa/LAN)
# =============================================================================
# JSON map di location_id → URL del wakeword-server LXC.
# Usato per push di wake_word_sensitivity e trigger_listen ai wakeword-server.
# Lasciare vuoto se non si usano wakeword-server dedicati.
# Format: '{"location_id":"http://<ip>:8200"}'
wakeword_server_urls: ""

# =============================================================================
# TTS ENGINE
# =============================================================================
# "cosyvoice3" = CosyVoice3-0.5B (GX10 GPU, zero-shot voice cloning)
# "kokoro" = Kokoro-82M (CPU, fallback cloud)
# Default: "cosyvoice3" per lxc_gpu, "kokoro" altrimenti
tts_engine: "cosyvoice3"

# URL del server CosyVoice3 (GX10 via Tailscale)
cosyvoice3_tts_url: "http://100.98.187.12:9880"

# Nome voce (mappato allo speaker zero-shot registrato sul server)
cosyvoice3_tts_voice: "sofia"

# Lingua per sintesi vocale
cosyvoice3_tts_language: "it"

# =============================================================================
# OPZIONALI
# =============================================================================

# Security Stack (Frigate + DoubleTake + MQTT)
install_security_stack: false
frigate_rtsp_password: ""

# Tailscale — gira host-level (non in Docker)
# Installazione: curl -fsSL https://tailscale.com/install.sh | sh
# Connessione:   tailscale up --hostname=jarvis-wagmi
# Non serve auth key nell'env — si autentica con tailscale up

# =============================================================================
# NGINX + PUBLIC ACCESS
# =============================================================================
# Nginx su LXC-JARVIS per jarvis.mintwork.it (Tailscale-only)
# Cloudflare Tunnel per jarvis-pub.mintwork.it (Telegram webhook)
install_nginx: true
nginx_domain: "jarvis.mintwork.it"
cloudflare_tunnel_enabled: true
cloudflare_tunnel_domain: "jarvis-pub.mintwork.it"

# Backup automatico DB — cron giornaliero alle 3:00
setup_backup_cron: false
backup_retention_days: 30
