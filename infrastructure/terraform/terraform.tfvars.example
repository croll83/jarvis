# =============================================================================
# JARVIS — Terraform Variables
# =============================================================================
# Copia questo file in terraform.tfvars e compila i valori
# NON committare terraform.tfvars nel repository!
#
# cp terraform.tfvars.example terraform.tfvars
# nano terraform.tfvars

# -----------------------------------------------------------------------------
# Componenti da creare (abilita/disabilita singolarmente)
# -----------------------------------------------------------------------------
# Scegli cosa creare su Proxmox. Puoi abilitarne anche solo uno.
jarvis_enabled      = true     # LXC-JARVIS (Ollama, Orchestrator — STT/TTS su GX10)
openclaw_enabled    = true     # LXC-OpenClaw (Gateway Gemini, Chrome headless)
workstation_enabled = false    # VM-Workstation (Ubuntu Desktop + Chrome reale)
# wakeword: si abilita aggiungendo istanze a wakeword_instances (sotto)

# -----------------------------------------------------------------------------
# Tipo di deploy (solo per LXC-JARVIS)
# -----------------------------------------------------------------------------
# "lxc_gpu" = LXC con GPU NVIDIA (Ollama router — STT/TTS su GX10 via Tailscale)
# "lxc"     = LXC senza GPU (AI via API — Groq/OpenRouter/Gemini)
deploy_type = "lxc_gpu"

# -----------------------------------------------------------------------------
# Connessione Proxmox
# -----------------------------------------------------------------------------
# URL dell'API Proxmox (include la porta 8006)
proxmox_endpoint = "https://192.168.1.10:8006/"

# API Token — crealo con:
#   pveum user add terraform@pve
#   pveum role add TerraformRole -privs "Datastore.AllocateSpace Datastore.Audit \
#     Pool.Allocate Sys.Audit Sys.Console Sys.Modify SDN.Use VM.Allocate VM.Audit \
#     VM.Clone VM.Config.CDROM VM.Config.Cloudinit VM.Config.CPU VM.Config.Disk \
#     VM.Config.HWType VM.Config.Memory VM.Config.Network VM.Config.Options \
#     VM.Migrate VM.PowerMgmt"
#   pveum aclmod / -user terraform@pve -role TerraformRole
#   pveum user token add terraform@pve provider --privsep=0
proxmox_api_token = "terraform@pve!provider=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Ignora certificati self-signed (true per la maggior parte delle installazioni)
proxmox_insecure = true

# Nome del nodo Proxmox (vedi nella UI: Datacenter > nodo)
proxmox_node = "pve"

# -----------------------------------------------------------------------------
# Container LXC
# -----------------------------------------------------------------------------
hostname       = "jarvis"
ct_id          = 100                    # 0 per auto-assign
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5... user@host"
lxc_password   = ""                     # Password root (opzionale)

# Risorse — adatta in base al deploy_type:
#   lxc_gpu: 8 core, 24 GB RAM, 400 GB disco (modelli AI ~12 GB + Docker images)
#   lxc:     2-4 core, 4 GB RAM, 50 GB disco
lxc_cores     = 8
lxc_memory    = 24576                   # 20 GB
lxc_swap      = 2048                    # MB
lxc_disk_size = 400                     # GB

# Template LXC Ubuntu — scaricalo da Proxmox UI:
#   Storage > local > CT Templates > Templates > ubuntu-24.04-standard
lxc_template_file_id = "local:vztmpl/ubuntu-24.04-standard_24.04-2_amd64.tar.zst"

# -----------------------------------------------------------------------------
# Rete
# -----------------------------------------------------------------------------
network_bridge = "vmbr0"
ip_address     = "192.168.1.50/24"      # oppure "dhcp"
gateway        = "192.168.1.1"          # necessario solo se IP statico
dns_servers    = ["8.8.8.8", "1.1.1.1"]

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
datastore_id = "local-lvm"

# -----------------------------------------------------------------------------
# GPU NVIDIA (solo se deploy_type = "lxc_gpu")
# -----------------------------------------------------------------------------
# Prerequisito: driver NVIDIA installato sull'HOST Proxmox
# Verifica con: nvidia-smi (sull'host)
#
# Trova i device con: ls -la /dev/nvidia*
gpu_devices = [
  "/dev/nvidia0",
  "/dev/nvidia-modeset",
  "/dev/nvidiactl",
  "/dev/nvidia-uvm",
  "/dev/nvidia-uvm-tools"
]

# Major number per cgroup — trova con:
#   stat -c '%t' /dev/nvidia0 | xargs printf '%d\n'    (→ 195)
#   stat -c '%t' /dev/nvidia-uvm | xargs printf '%d\n' (→ varia: 234, 507, etc.)
#   stat -c '%t' /dev/nvidia-caps/nvidia-cap1 | xargs printf '%d\n' (→ varia: 509, 510, etc.)
# I valori dipendono dalla versione del driver NVIDIA. Verifica SEMPRE sull'host.
gpu_cgroup_device_majors = [195, 234, 509]

# -----------------------------------------------------------------------------
# LXC-OpenClaw (Gateway Gemini + Chrome headless)
# -----------------------------------------------------------------------------
# Node.js bare-metal, Chrome headless CDP, browser-dom plugin.
# NO Docker, NO GPU. Configurato da Ansible: playbooks/openclaw.yml
openclaw_hostname    = "jarvis-openclaw"
openclaw_ct_id       = 101                   # 0 per auto-assign
openclaw_cores       = 2
openclaw_memory      = 8192                  # 8 GB
openclaw_disk_size   = 200                   # GB
openclaw_ip_address  = "192.168.1.51/24"     # oppure "dhcp"
# Template: usa lo stesso di lxc_template_file_id se non specificato

# -----------------------------------------------------------------------------
# VM Workstation (opzionale — Ubuntu Desktop + XFCE)
# -----------------------------------------------------------------------------
# VM desktop per: Chrome reale + OpenClaw browser extension, IDE, Git, dev.
# Accessibile via RDP (xrdp) e noVNC Proxmox. NO GPU dedicata.
# Vedi WORKSTATION.md per la configurazione post-install.
#
# Prerequisito: scarica la ISO di Ubuntu Desktop su Proxmox:
#   Proxmox UI > local storage > ISO Images > Download from URL:
#   https://releases.ubuntu.com/24.04.2/ubuntu-24.04.2-desktop-amd64.iso

workstation_hostname      = "jarvis-workstation"
workstation_vm_id         = 200                  # 0 per auto-assign
workstation_cores         = 6
workstation_memory        = 12288                # 12 GB
workstation_disk_size     = 400                  # GB
workstation_iso_file_id   = "local:iso/ubuntu-24.04.2-desktop-amd64.iso"
workstation_ip_address    = "192.168.1.60/24"    # oppure "dhcp"
workstation_password      = ""                   # Password utente jarvis

# -----------------------------------------------------------------------------
# Wakeword Server (opzionale — uno per casa/LAN)
# -----------------------------------------------------------------------------
# LXC leggero con openWakeWord server-side. I device AtomS3R streamano
# audio continuo via WS e il server rileva "hey jarvis" localmente.
# Richiede Tailscale per la connessione all'orchestrator VPS.
#
# Una istanza per casa/LAN. Mappa vuota {} = disabilitato.
# Dopo terraform apply, configurare con: cloud/scripts/deploy-wakeword.sh
# oppure con Ansible: ansible-playbook playbooks/wakeword.yml

wakeword_instances = {
  # "albani20" = {
  #   ct_id              = 210                          # Proxmox CT ID
  #   ip_address         = "192.168.1.210/24"           # IP statico sulla LAN locale
  #   hostname           = "jarvis-wakeword"            # Hostname container
  #   node_name          = "pve-albani20"               # Nodo Proxmox dove creare il CT
  #   tailscale_authkey  = "tskey-auth-xxxxx"           # Chiave Tailscale (opzionale)
  # }
  # "casa2" = {
  #   ct_id              = 211
  #   ip_address         = "192.168.1.211/24"
  #   hostname           = "jarvis-wakeword-casa2"
  #   node_name          = "pve-casa2"
  #   tailscale_authkey  = "tskey-auth-yyyyy"
  # }
}
