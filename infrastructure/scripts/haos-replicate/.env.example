# =============================================================================
# HAOS replicate — segreti/parametri (copia in .env)
# =============================================================================
# .env è in .gitignore: NON committarlo.

# --- Target: la NUOVA istanza HAOS Wagmi ---
HASS_URL="http://homeassistant.local:8123"     # o https://<ip>:8123
HASS_TOKEN="INCOLLA_QUI_IL_LONG_LIVED_TOKEN_DEL_NUOVO_HAOS"

# --- Copia add-on locale (opzionale ma consigliato) ---
# Se impostato, replicate.sh copia ha_memory_service/ in /addons/jarvis_ha_memory.
# Punta alla VM HAOS via SSH (add-on "Advanced SSH" sulla porta 22, o IP host).
#SSH_TARGET="root@192.168.1.XX"
#SSH_OPTS="-o StrictHostKeyChecking=accept-new"

# --- Segreti add-on (NUOVI, non riusare quelli di Albani) ---
SSH_ADDON_PASSWORD="CAMBIA_QUESTA_PASSWORD"
SSH_AUTHORIZED_KEY="ssh-ed25519 AAAA... la-tua-chiave-pubblica"

# --- JARVIS HA Memory (lascia vuoto se usi backend locale 'ollama') ---
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
