# =============================================================================
# JARVIS Cloud Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# This must be the same on the AtomS3R to authenticate them:
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match CONFIG_JARVIS_API_TOKEN in atoms3r-jarvis sdkconfig.
# If empty, device auth is disabled (all requests accepted).
DEVICE_API_TOKEN=

# =============================================================================
# AI BACKEND CONFIGURATION
# =============================================================================
# Backend Mode: "api" for cloud (Groq STT + OpenRouter routing)
AI_BACKEND=api

# --- Groq API (STT - Whisper) ---
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenRouter API (Routing - Qwen 2.5 7B) ---
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# OPENCLAW (Brain - Gemini 3 Pro) — gira bare-metal, NON in Docker
# =============================================================================
# Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenClaw URL — TLS via Let's Encrypt (Cloudflare DNS)
#   DNS: openclaw.mintwork.it → Tailscale IP
OPENCLAW_URL=https://openclaw.mintwork.it:18789

# Gateway token for skill authentication — generate with: openssl rand -hex 32
# DEVE essere lo stesso valore usato in openclaw onboard
OPENCLAW_GATEWAY_TOKEN=your_gateway_token

# OpenClaw Telegram bot — Create with @BotFather
OPENCLAW_TELEGRAM_BOT_TOKEN=your_openclaw_bot_token

# OpenClaw Gateway WS — operator mode for exec approval buttons
# Same host/port as OPENCLAW_URL but with wss:// scheme
OPENCLAW_WS_URL=wss://openclaw.mintwork.it:18789

# OpenClaw Exec Approval Socket — token from ~/.openclaw/exec-approvals.json
# The orchestrator listens on this socket; OpenClaw connects to request approvals.
OPENCLAW_APPROVAL_SOCKET_PATH=/home/jarvis/.openclaw/exec-approvals.sock
OPENCLAW_APPROVAL_SOCKET_TOKEN=

# =============================================================================
# JARVIS APPROVAL BOT (L3 critical actions)
# =============================================================================
# Separate Telegram bot for security confirmations (locks, alarm, cameras)
JARVIS_APPROVAL_BOT_TOKEN=your_approval_bot_token
JARVIS_APPROVAL_CHAT_ID=your_chat_id

# =============================================================================
# TAILSCALE (VPN Mesh - Multi-Location HA)
# =============================================================================
# Tailscale gira host-level (NON in Docker).
# Installazione: curl -fsSL https://tailscale.com/install.sh | sh
# Connessione:   tailscale up --hostname=jarvis-cloud
# Non serve auth key nel .env — si autentica con tailscale up.

# Auth key per connessione headless (usata da setup-vps.sh)
# Genera da: https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=tskey-auth-xxxxx
TAILSCALE_HOSTNAME=cloud

# Tailscale IPv4 di questa macchina (usato da docker-compose per bind ontology-server)
# Ottieni con: tailscale ip -4
TAILSCALE_IP=100.x.x.x

# =============================================================================
# HOME ASSISTANT CONFIGURATION
# =============================================================================
# Primary HA instance (via Tailscale — use MagicDNS or 100.x.x.x)
HASS_URL=http://ha-wagmi.tailnet-xxx.ts.net:8123
JARVIS_HASS_TOKEN=your_long_lived_access_token_here

# Additional HA instances (optional)
# HASS_URL_WAGMI=http://100.xxx.xxx.xxx:8123
# HASS_TOKEN_WAGMI=token_here

# =============================================================================
# EMAIL CONFIGURATION (OTP Authentication)
# =============================================================================
JARVIS_SMTP_HOST=smtp.gmail.com
JARVIS_SMTP_PORT=587
JARVIS_SMTP_USER=your_email@gmail.com
JARVIS_SMTP_PASSWORD=your_app_password_here
JARVIS_SMTP_FROM=jarvis@yourdomain.com
JARVIS_SMTP_TLS=true

# =============================================================================
# ONTOLOGY SERVER (Knowledge Graph API)
# =============================================================================
# Bearer token per autenticazione API (opzionale — se vuoto, nessuna auth)
# Generate with: openssl rand -hex 32
ONTOLOGY_API_TOKEN=

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# TELEGRAM WEBHOOK (opzionale)
# =============================================================================
# Public HTTPS URL for Telegram bot webhook.
# If set, registers webhook on startup instead of getUpdates polling.
# Requires a reverse proxy (nginx) with valid SSL certificate.
# Example: https://jarvis-pub.yourdomain.com/telegram_webhook
TELEGRAM_WEBHOOK_URL=

# =============================================================================
# WAKEWORD SERVERS (opzionale — uno per casa/LAN)
# =============================================================================
# JSON map di location_id → URL del wakeword-server LXC.
# Usato per push di wake_word_sensitivity e trigger_listen ai wakeword-server.
# Lasciare vuoto se non si usano wakeword-server dedicati.
# Format: {"location_id":"http://<ip>:8200", ...}
WAKEWORD_SERVER_URLS=

# =============================================================================
# TIMEOUTS (seconds)
# =============================================================================
OPENCLAW_TIMEOUT=30
