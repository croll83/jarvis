# =============================================================================
# OpenClaw Environment Variables
# =============================================================================
# Copia in ~/.openclaw/openclaw.env e compila i valori:
#   cp /opt/jarvis/cloud/openclaw.env.example ~/.openclaw/openclaw.env
#   nano ~/.openclaw/openclaw.env
#
# Letto dal servizio systemd openclaw.service via EnvironmentFile.
# Il prefisso '-' nel service file rende il file opzionale (non blocca se mancante).

# --- gogcli (GOG Galaxy CLI) ---
# Necessario per la skill gogcli di OpenClaw
GOG_KEYRING_PASSWORD=
GOG_ACCOUNT=
