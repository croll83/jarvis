# =============================================================================
# JARVIS Environment Configuration (Locale — GPU)
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
# =============================================================================
# AI BACKEND
# =============================================================================
# "local" = Ollama (Qwen 2.5 3B) + Whisper (GPU required)
# "api"   = Groq (STT) + OpenRouter (routing)
AI_BACKEND=local

# =============================================================================
# OPENCLAW (Brain - Gemini 3 Pro) — gira su VM separata, NON in Docker
# =============================================================================
# Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Gateway token for skill authentication — generate with: openssl rand -hex 32
# DEVE essere lo stesso valore usato in openclaw onboard sulla VM OpenClaw
OPENCLAW_GATEWAY_TOKEN=your_gateway_token

# URL della VM OpenClaw (TLS via Let's Encrypt)
OPENCLAW_URL=https://openclaw.mintwork.it:18789

# OpenClaw Telegram bot — Create with @BotFather
OPENCLAW_TELEGRAM_BOT_TOKEN=your_openclaw_bot_token

# OpenClaw Gateway WS — operator mode per exec approval buttons
# Same host/port as OPENCLAW_URL but with wss:// scheme
OPENCLAW_WS_URL=wss://openclaw.mintwork.it:18789

# =============================================================================
# JARVIS APPROVAL BOT (L3 critical actions)
# =============================================================================
# Separate Telegram bot for security confirmations (locks, alarm, cameras)
# This is NOT the same bot as OpenClaw Telegram — prevents prompt injection
JARVIS_APPROVAL_BOT_TOKEN=your_approval_bot_token
JARVIS_APPROVAL_CHAT_ID=your_chat_id

# =============================================================================
# DEVICE FIRMWARE AUTH (AtomS3R Bearer Token)
# =============================================================================
# Static token for device firmware authentication.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match CONFIG_JARVIS_API_TOKEN in atoms3r-jarvis sdkconfig.
# If empty, device auth is disabled (all requests accepted).
DEVICE_API_TOKEN=

# =============================================================================
# TAILSCALE (VPN Mesh - Multi-Location HA)
# =============================================================================
# Tailscale gira host-level (NON in Docker).
# Installazione: curl -fsSL https://tailscale.com/install.sh | sh
# Connessione:   tailscale up --hostname=jarvis-wagmi
# Non serve auth key nel .env — si autentica con tailscale up.

# Timeouts for HA instances (seconds)
TAILSCALE_TIMEOUT_LOCAL=10.0
TAILSCALE_TIMEOUT_REMOTE=15.0

# =============================================================================
# HOME ASSISTANT
# =============================================================================
HASS_URL=http://homeassistant:8123
JARVIS_HASS_TOKEN=your_long_lived_access_token

# =============================================================================
# AI MODELS (opzionale — override dei default in config.py)
# =============================================================================
# Ollama routing model — default: qwen2.5:3b
#ROUTER_MODEL=qwen2.5:3b

# =============================================================================
# API KEYS (only needed if AI_BACKEND=api)
# =============================================================================
# Groq — STT (Whisper cloud) — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — Routing fallback — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Brave Search API — https://brave.com/search/api/
# Used by Qwen tool calling (web_search)
BRAVE_API_KEY=

# OpenRouter routing model — default: qwen/qwen-2.5-3b-instruct
#OPENROUTER_ROUTER_MODEL=qwen/qwen-2.5-3b-instruct

# TTS preprocessing: regole deterministiche (default) + LLM opzionale
# TTS_PREPROCESS_ENABLED=true    # Regex markdown strip, num2words, translittering
# TTS_PREPROCESS_LLM=false       # LLM addizionale (lento, ~1s latenza)

# =============================================================================
# EMAIL (OTP Authentication for Admin Dashboard)
# =============================================================================
JARVIS_SMTP_HOST=smtp.gmail.com
JARVIS_SMTP_PORT=587
JARVIS_SMTP_USER=your_email@gmail.com
JARVIS_SMTP_PASSWORD=your_app_password
JARVIS_SMTP_FROM=jarvis@yourdomain.com
JARVIS_SMTP_TLS=true

# =============================================================================
# TELEGRAM WEBHOOK (opzionale)
# =============================================================================
# Public HTTPS URL for Telegram bot webhook.
# If set, registers webhook on startup instead of getUpdates polling.
# Requires a reverse proxy (nginx) with valid SSL certificate.
# Example: https://jarvis-pub.yourdomain.com/telegram_webhook
TELEGRAM_WEBHOOK_URL=

# =============================================================================
# WAKEWORD SERVERS (opzionale — uno per casa/LAN)
# =============================================================================
# JSON map di location_id → URL del wakeword-server LXC.
# Usato per push di wake_word_sensitivity e trigger_listen ai wakeword-server.
# Lasciare vuoto se non si usano wakeword-server dedicati.
# Format: {"location_id":"http://<ip>:8200", ...}
WAKEWORD_SERVER_URLS=

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# ONTOLOGY SERVER (Knowledge Graph API)
# =============================================================================
# Bearer token per autenticazione API (opzionale — se vuoto, nessuna auth)
# Generate with: openssl rand -hex 32
ONTOLOGY_API_TOKEN=

# =============================================================================
# DATABASE (PostgreSQL + MongoDB for side projects)
# =============================================================================
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=main
MONGO_USER=jarvis
MONGO_PASSWORD=your_mongo_password

# =============================================================================
# NGINX + PUBLIC ACCESS (opzionale)
# =============================================================================
# jarvis.mintwork.it:   Nginx + SSL (Tailscale-only, certbot DNS Cloudflare)
# jarvis-pub.mintwork.it: Cloudflare Tunnel (Telegram webhook, public health)
# CLOUDFLARE_API_TOKEN is NOT in .env — it's in /etc/letsencrypt/cloudflare.ini
