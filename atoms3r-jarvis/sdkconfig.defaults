# =============================================================================
# JARVIS AtomS3R - ESP-IDF SDK Configuration Defaults
# =============================================================================
#
# Hardware: M5Stack AtomS3R (ESP32-S3-PICO-1-N8R8)
# - Flash: 8MB (Octal SPI)
# - PSRAM: 8MB (Octal SPI)
#
# =============================================================================

# Target: ESP32-S3
CONFIG_IDF_TARGET="esp32s3"

# =============================================================================
# Flash Configuration (8MB OPI)
# =============================================================================
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_OPI=y
CONFIG_ESPTOOLPY_FLASH_SAMPLE_MODE_STR=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# =============================================================================
# PSRAM Configuration (8MB OPI - ESSENZIALE per ESP-SR)
# =============================================================================
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# PSRAM timing tuning per OPI
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# =============================================================================
# Partition Table
# =============================================================================
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# =============================================================================
# ESP-SR WakeNet Configuration
# =============================================================================
CONFIG_SR_WN_WN9_JARVIS=y
CONFIG_AFE_INTERFACE_V1=y

# Disable unused models to save flash space
CONFIG_SR_MN_EN_MULTINET6_QUANT=n
CONFIG_SR_MN_CN_MULTINET6_QUANT=n
CONFIG_SR_MN_EN_MULTINET5_QUANT=n
CONFIG_SR_MN_CN_MULTINET5_QUANT=n

# =============================================================================
# CPU and FreeRTOS
# =============================================================================
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_FREERTOS_HZ=1000

# Stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# =============================================================================
# WiFi
# =============================================================================
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# =============================================================================
# Log Level
# =============================================================================
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# =============================================================================
# Bootloader
# =============================================================================
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y

# =============================================================================
# Compiler Optimization (per risparmiare flash)
# =============================================================================
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# =============================================================================
# Device Configuration (da personalizzare via menuconfig)
# =============================================================================
CONFIG_WIFI_SSID="YOUR_WIFI_SSID"
CONFIG_WIFI_PASSWORD="YOUR_WIFI_PASSWORD"
CONFIG_JARVIS_SERVER_HOST="jarvis.local"
CONFIG_JARVIS_SERVER_PORT=5000
CONFIG_DEVICE_ROOM="salotto"
CONFIG_DEVICE_ID="atoms3r_salotto"
