# =============================================================================
# OpenClaw Headless Chrome — systemd service
# =============================================================================
# Manages a headless Chrome instance for the browser-dom plugin.
# Chrome exposes CDP (Chrome DevTools Protocol) on port 18800.
#
# Install:
#   sudo cp openclaw-chrome.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now openclaw-chrome
#
# Verify:
#   curl -s http://127.0.0.1:18800/json/version
#   sudo systemctl status openclaw-chrome

[Unit]
Description=OpenClaw Headless Chrome (CDP :18800)
Documentation=https://github.com/AnirudhRanganathan/jarvis
After=network.target
Before=openclaw.service

[Service]
Type=simple
User=jarvis
Group=jarvis
Environment=HOME=/home/jarvis

# Remove stale singleton files from previous crashes / pkill chrome
ExecStartPre=/bin/rm -f /home/jarvis/.openclaw/browser/openclaw/user-data/SingletonLock
ExecStartPre=/bin/rm -f /home/jarvis/.openclaw/browser/openclaw/user-data/SingletonCookie
ExecStartPre=/bin/rm -f /home/jarvis/.openclaw/browser/openclaw/user-data/SingletonSocket

ExecStart=/usr/bin/google-chrome \
    --headless=new \
    --no-sandbox \
    --disable-gpu \
    --disable-dev-shm-usage \
    --disable-software-rasterizer \
    --disable-background-networking \
    --disable-default-apps \
    --disable-extensions \
    --disable-sync \
    --disable-translate \
    --metrics-recording-only \
    --no-first-run \
    --mute-audio \
    --remote-debugging-port=18800 \
    --remote-debugging-address=127.0.0.1 \
    --user-data-dir=/home/jarvis/.openclaw/browser/openclaw/user-data \
    --window-size=1920,1080 \
    about:blank

Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# Resource limits
MemoryMax=1G
CPUQuota=150%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=openclaw-chrome

[Install]
WantedBy=multi-user.target
