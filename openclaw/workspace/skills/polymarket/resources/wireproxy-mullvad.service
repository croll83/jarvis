[Unit]
Description=WireProxy SOCKS5 via Mullvad (for Polymarket CLOB)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/mullvad-wg-configs/wireproxy-launcher.sh
Restart=on-failure
RestartSec=10
Environment=WIREPROXY_SOCKS_PORT=1080

# Give it time to find a working server
TimeoutStartSec=300

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wireproxy-mullvad

[Install]
WantedBy=default.target
