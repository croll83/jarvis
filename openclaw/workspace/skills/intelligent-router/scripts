        ("what time is it", "SIMPLE", "EN"),
        ("che ore sono", "SIMPLE", "IT"),
        ("show me the status", "SIMPLE", "EN"),
        ("mostrami lo stato", "SIMPLE", "IT"),
        ("ciao", "SIMPLE", "IT"),
        ("hello", "SIMPLE", "EN"),
        ("ok grazie", "SIMPLE", "IT"),

        # ── MEDIUM ──
        ("fix the bug in the login page", "MEDIUM", "EN"),
        ("correggi il bug nella pagina di login", "MEDIUM", "IT"),
        ("summarize this article and list the key points in detail", "MEDIUM", "EN"),
        ("riassumi questo articolo ed elenca i punti chiave nel dettaglio", "MEDIUM", "IT"),
        ("create a simple script to parse CSV files", "MEDIUM", "EN"),
        ("crea uno script per parsare il CSV", "MEDIUM", "IT"),
        ("analizza questo errore nel codice", "MEDIUM", "IT"),
        ("explain how docker containers work", "MEDIUM", "EN"),
        ("spiega come funzionano i container docker", "MEDIUM", "IT"),

        # ── COMPLEX ──
        ("debug complesso del memory leak nel sistema distribuito", "CRITICAL", "IT"),
        ("analisi approfondita sicurezza del sistema di autenticazione e ottimizzazione performance", "CRITICAL", "IT"),
        ("refactor the entire codebase to use microservices architecture with CI/CD pipeline", "COMPLEX", "EN"),
        ("riscrivi il classificatore per supportare italiano e inglese con analisi dettagliata", "COMPLEX", "IT"),
        ("design a distributed caching system with load balancing, high availability and performance optimization", "COMPLEX", "EN"),
        ("progetta un sistema di caching distribuito con bilanciamento carico, alta disponibilità e ottimizzazione", "CRITICAL", "IT"),

        # ── REASONING ──
        ("prove that sqrt(2) is irrational step by step", "REASONING", "EN"),
        ("dimostra che la radice di 2 è irrazionale passo dopo passo", "REASONING", "IT"),
        ("derive the formula using mathematical induction and verify the proof", "REASONING", "EN"),
        ("ragiona sulla dimostrazione logica del teorema", "REASONING", "IT"),

        # ── CRITICAL ──
        ("comprehensive security audit of production authentication system with encryption review, disaster recovery, performance optimization and scalability assessment end to end", "CRITICAL", "EN"),
        ("audit sicurezza del sistema di produzione con revisione crittografia, piano disaster recovery, alta disponibilità e ottimizzazione performance end to end", "CRITICAL", "IT"),

        # ── Marco's required test cases ──
        ("ragiona sulla strategia di trading", "REASONING", "IT"),
        ("debug il classificatore che classifica male", "COMPLEX", "IT"),
        ("quale è il meteo domani?", "SIMPLE", "IT"),
        ("analizza la sicurezza di OpenClaw", "CRITICAL", "IT"),
    ]

    passed = 0
    failed = 0
    results = []

    for task, expected, lang in test_cases:
        classification = router.classify_task(task, return_details=True)
        actual = classification['tier']
        ok = actual == expected
        if ok:
            passed += 1
        else:
            failed += 1
        status = "✅" if ok else "❌"
        results.append((status, lang, expected, actual, classification['weighted_score'], task))

    print(f"Intelligent Router v3.0 — Bilingual Test Suite")
    print(f"{'='*70}")

    for status, lang, expected, actual, score, task in results:
        task_short = task[:50] + "..." if len(task) > 50 else task
        match_str = f"{expected:>10}" if expected == actual else f"{expected:>10} → got {actual}"
        print(f"  {status} [{lang}] {match_str} (score={score:.3f}) {task_short}")

    print(f"\n{'='*70}")
    print(f"Results: {passed} passed, {failed} failed, {passed + failed} total")

    if failed > 0:
        sys.exit(1)


