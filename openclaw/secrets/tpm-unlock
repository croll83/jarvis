#!/usr/bin/env bash
# Unlock TPM: write password to tmpfs so services can use it
# Run this once after each reboot, then start openclaw-gateway
set -euo pipefail

TPM_AUTH_FILE="/run/user/$(id -u)/tpm-auth"
TPM_HANDLE="0x81000001"
export TPM2TOOLS_TCTI="device:/dev/tpmrm0"

if [ -n "${1:-}" ]; then
    TPM_PASS="$1"
else
    read -s -p "TPM password: " TPM_PASS
    echo
fi

# Verify the password works
tpm2_flushcontext -s 2>/dev/null || true
VERIFY=$(tpm2_unseal -c "$TPM_HANDLE" -p "$TPM_PASS" 2>&1) || {
    echo "ERROR: Wrong password or TPM error: $VERIFY" >&2
    exit 1
}

if ! echo "$VERIFY" | grep -q "^AGE-SECRET-KEY-"; then
    echo "ERROR: TPM returned invalid data" >&2
    exit 1
fi

# Write to tmpfs (survives until reboot)
umask 077
echo -n "$TPM_PASS" > "$TPM_AUTH_FILE"
echo "TPM unlocked. Password saved to $TPM_AUTH_FILE (tmpfs, cleared on reboot)"
echo "You can now start the gateway: systemctl --user start openclaw-gateway"
