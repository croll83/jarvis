#!/usr/bin/env bash
# Rotate the TPM password for the sealed age key
# The age key and SOPS vault remain unchanged — only the TPM "lock" changes
set -euo pipefail

export TPM2TOOLS_TCTI="device:/dev/tpmrm0"
TPM_HANDLE="0x81000001"
TPM_AUTH_FILE="/run/user/$(id -u)/tpm-auth"
TMP_DIR=$(mktemp -d)
trap 'shred -u "$TMP_DIR"/* 2>/dev/null; rmdir "$TMP_DIR" 2>/dev/null' EXIT

# --- Read old password ---
if [ -n "${1:-}" ]; then
    OLD_PASS="$1"
elif [ -f "$TPM_AUTH_FILE" ]; then
    OLD_PASS=$(cat "$TPM_AUTH_FILE")
else
    read -s -p "Current TPM password: " OLD_PASS; echo
fi

# --- Read new password ---
if [ -n "${2:-}" ]; then
    NEW_PASS="$2"
else
    read -s -p "New TPM password: " NEW_PASS; echo
    read -s -p "Confirm new password: " NEW_PASS2; echo
    if [ "$NEW_PASS" != "$NEW_PASS2" ]; then
        echo "ERROR: Passwords don't match" >&2
        exit 1
    fi
fi

if [ -z "$NEW_PASS" ]; then
    echo "ERROR: New password cannot be empty" >&2
    exit 1
fi

# --- Flush all stale sessions ---
tpm2_flushcontext -s 2>/dev/null || true
tpm2_flushcontext -t 2>/dev/null || true
tpm2_flushcontext -l 2>/dev/null || true

# --- Unseal age key with old password ---
echo "Unsealing age key with current password..."
AGE_KEY=$(tpm2_unseal -c "$TPM_HANDLE" -p "$OLD_PASS" 2>&1) || {
    echo "ERROR: Wrong current password or TPM error: $AGE_KEY" >&2
    exit 1
}

if ! echo "$AGE_KEY" | grep -q "^AGE-SECRET-KEY-"; then
    echo "ERROR: TPM returned invalid data (not an age key)" >&2
    exit 1
fi
echo "Age key unsealed OK."

# --- Create new sealed object FIRST (before removing old handle) ---
echo "Creating new primary key..."
tpm2_flushcontext -s 2>/dev/null || true
tpm2_flushcontext -t 2>/dev/null || true
tpm2_createprimary -C o -c "$TMP_DIR/primary.ctx" 2>&1 || {
    echo "ERROR: Failed to create primary key. Old handle still intact." >&2
    exit 1
}

echo "Sealing age key with new password..."
echo -n "$AGE_KEY" > "$TMP_DIR/age.key"
tpm2_create \
    -C "$TMP_DIR/primary.ctx" \
    -i "$TMP_DIR/age.key" \
    -u "$TMP_DIR/seal.pub" \
    -r "$TMP_DIR/seal.priv" \
    -p "$NEW_PASS" 2>&1 || {
    shred -u "$TMP_DIR/age.key"
    echo "ERROR: Failed to create sealed object. Old handle still intact." >&2
    exit 1
}
shred -u "$TMP_DIR/age.key"

tpm2_flushcontext -s 2>/dev/null || true
tpm2_flushcontext -t 2>/dev/null || true

tpm2_load \
    -C "$TMP_DIR/primary.ctx" \
    -u "$TMP_DIR/seal.pub" \
    -r "$TMP_DIR/seal.priv" \
    -c "$TMP_DIR/seal.ctx" 2>&1 || {
    echo "ERROR: Failed to load sealed object. Old handle still intact." >&2
    exit 1
}
echo "New sealed object created OK."

# --- Now remove old handle and persist new one ---
echo "Swapping persistent handle..."
tpm2_evictcontrol -C o -c "$TPM_HANDLE" 2>&1 || {
    echo "ERROR: Failed to remove old persistent handle" >&2
    exit 1
}

tpm2_evictcontrol -C o -c "$TMP_DIR/seal.ctx" "$TPM_HANDLE" 2>&1 || {
    echo "CRITICAL: Failed to persist new object! Trying to restore old one..." >&2
    # Try to restore from old blobs
    tpm2_flushcontext -s 2>/dev/null || true
    tpm2_createprimary -C o -c "$TMP_DIR/old_primary.ctx" 2>/dev/null
    tpm2_load -C "$TMP_DIR/old_primary.ctx" \
        -u "$HOME/.openclaw/secrets/tpm/seal.pub" \
        -r "$HOME/.openclaw/secrets/tpm/seal.priv" \
        -c "$TMP_DIR/old_seal.ctx" 2>/dev/null
    tpm2_evictcontrol -C o -c "$TMP_DIR/old_seal.ctx" "$TPM_HANDLE" 2>/dev/null && \
        echo "Old handle restored. Rotation aborted." >&2 || \
        echo "FAILED TO RESTORE! Age key: $AGE_KEY — SAVE THIS NOW!" >&2
    exit 1
}
echo "Handle swapped OK."

# --- Verify new password works ---
tpm2_flushcontext -s 2>/dev/null || true
tpm2_flushcontext -t 2>/dev/null || true
VERIFY=$(tpm2_unseal -c "$TPM_HANDLE" -p "$NEW_PASS" 2>&1) || {
    echo "CRITICAL: Verification failed! $VERIFY" >&2
    echo "The age key is: $AGE_KEY" >&2
    echo "SAVE THIS KEY IMMEDIATELY and re-seal manually!" >&2
    exit 1
}

if [ "$VERIFY" != "$AGE_KEY" ]; then
    echo "CRITICAL: Verified key doesn't match original!" >&2
    echo "The age key is: $AGE_KEY" >&2
    echo "SAVE THIS KEY IMMEDIATELY!" >&2
    exit 1
fi
echo "Verification OK."

# --- Update backup blobs ---
cp "$TMP_DIR/seal.pub" "$HOME/.openclaw/secrets/tpm/seal.pub"
cp "$TMP_DIR/seal.priv" "$HOME/.openclaw/secrets/tpm/seal.priv"

# --- Update tmpfs password file ---
umask 077
echo -n "$NEW_PASS" > "$TPM_AUTH_FILE"

# --- Clear sensitive vars ---
unset AGE_KEY OLD_PASS NEW_PASS VERIFY

echo ""
echo "Password rotated successfully."
echo "Updated: TPM handle $TPM_HANDLE, $TPM_AUTH_FILE, ~/.openclaw/secrets/tpm/seal.*"
